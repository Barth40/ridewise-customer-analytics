# ===============================
# Python cache and compiled files
# ===============================
__pycache__/
*.py[cod]
*$py.class
*.so

# ===============================
# Virtual environments
# ===============================
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ===============================
# Environment variables and secrets
# ===============================
.env
.env.*
.envrc
.streamlit/secrets.toml

# Private keys
*.pem
*.key

# ===============================
# Jupyter and IPython
# ===============================
.ipynb_checkpoints/
profile_default/
ipython_config.py

# ===============================
# Raw data and generated outputs
# ===============================
data/*
!data/.gitkeep

output/
reports/*
!reports/.gitkeep

# Ignore CSV datasets
*.csv

# ===============================
# Model artifacts
# ===============================
# Keep the deployment models required by FastAPI.
# Ignore other generated model files if necessary.

models/*
!models/.gitkeep
!models/churn_prediction_model.pkl
!models/churn_prediction_threshold.pkl

# ===============================
# MLflow artifacts
# ===============================
mlruns/
notebooks/mlruns/
mlflow_artifacts/
notebooks/mlflow_artifacts/
mlflow.db

# ===============================
# Logs and local databases
# ===============================
*.log
logs/
db.sqlite3
db.sqlite3-journal

